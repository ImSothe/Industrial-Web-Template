# Copy to .env and fill in your own data (NEVER commit .env)
PORT=3000
ALLOWED_ORIGIN=http://localhost:8080
# TRUST_PROXY=true   # only behind a reverse proxy (needed for per-IP lockout to see real IPs)

# Staff login: hash made with `npm run hash-password -- "a passphrase longer than 12 chars"`
EMPLOYEE_PASSWORD_HASH=
# Random string, 32+ chars (e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=

# SMTP (app password, Brevo, Mailgun, SES...)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=orders@your-company.example
SMTP_PASS=

# Sender and internal recipient
MAIL_FROM="[YOUR_COMPANY] Orders <orders@your-company.example>"
OFFICE_EMAIL=engineering@your-company.example

# ERP / SQL Server (optional: without it /api/tariffs answers 503 and the web uses FALLBACK_TARIFFS)
DB_SERVER=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_TRUST_CERT=false
